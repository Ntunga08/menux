datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  STAFF
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum RequestType {
  CALL_WAITER
  REQUEST_BILL
  REFILL_WATER
  COMPLAINT
  OTHER
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id               Int              @id @default(autoincrement())
  name             String
  email            String           @unique
  passwordHash     String
  role             UserRole
  isActive         Boolean          @default(true)
  resolvedRequests ServiceRequest[] @relation("ResolvedBy")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([role])
  @@index([isActive])
}

model Table {
  id          Int              @id @default(autoincrement())
  tableNumber Int              @unique
  qrCodeValue String           @unique
  capacity    Int
  status      TableStatus      @default(AVAILABLE)
  section     String?
  isActive    Boolean          @default(true)
  requests    ServiceRequest[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([section])
  @@index([isActive])
}

model MenuCategory {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model MenuItem {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  price       Decimal      @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean      @default(true)
  sortOrder   Int          @default(0)
  categoryId  Int
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
  @@index([isAvailable])
  @@index([sortOrder])
  @@index([name])
}

model ServiceRequest {
  id           Int           @id @default(autoincrement())
  requestType  RequestType
  status       RequestStatus @default(PENDING)
  priority     Int           @default(1)
  note         String?
  tableId      Int
  table        Table         @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedById Int?
  resolvedBy   User?         @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  resolvedAt   DateTime?

  @@index([status])
  @@index([tableId])
  @@index([createdAt])
  @@index([priority])
  @@index([requestType])
}
