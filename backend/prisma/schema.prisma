datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── ENUMS ───────────────────────────────────────────────

enum StaffRole {
  MANAGER
  WAITER
  CHEF
  CASHIER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum RequestType {
  CALL_WAITER
  REQUEST_BILL
  REFILL_WATER
  COMPLAINT
  OTHER
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── MODELS ──────────────────────────────────────────────

// The SaaS customer — pays you, owns restaurants
model Owner {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  plan         String       @default("free") // free | pro | enterprise
  isActive     Boolean      @default(true)
  restaurants  Restaurant[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// One owner can have multiple branches
model Restaurant {
  id           Int              @id @default(autoincrement())
  name         String
  logoUrl      String?
  address      String?
  currency     String           @default("USD")
  subdomain    String           @unique
  isActive     Boolean          @default(true)
  ownerId      Int
  owner        Owner            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  staff        Staff[]
  tables       Table[]
  categories   MenuCategory[]
  orders       Order[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([ownerId])
}

// Waiters, chefs, managers etc — invited by owner
model Staff {
  id               Int              @id @default(autoincrement())
  name             String?
  email            String
  passwordHash     String?
  role             StaffRole
  fcmToken         String?          // phone push notification token
  inviteToken      String?          @unique
  inviteAccepted   Boolean          @default(false)
  isActive         Boolean          @default(true)
  restaurantId     Int
  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  resolvedRequests ServiceRequest[] @relation("ResolvedBy")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([restaurantId, email])  // same email can work at 2 restaurants
  @@index([restaurantId])
  @@index([role])
}

model Table {
  id           Int              @id @default(autoincrement())
  tableNumber  Int
  qrToken      String           @unique
  capacity     Int
  status       TableStatus      @default(AVAILABLE)
  section      String?
  isActive     Boolean          @default(true)
  restaurantId Int
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  requests     ServiceRequest[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([restaurantId, tableNumber]) // table 5 can exist in 2 restaurants
  @@index([restaurantId])
  @@index([status])
}

model MenuCategory {
  id           Int          @id @default(autoincrement())
  name         String
  description  String?
  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)
  restaurantId Int
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([sortOrder])
}

model MenuItem {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  price       Decimal      @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean      @default(true)
  sortOrder   Int          @default(0)
  categoryId  Int
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isAvailable])
}

// Customer places an order from their phone
model Order {
  id           Int         @id @default(autoincrement())
  status       OrderStatus @default(PENDING)
  total        Decimal     @db.Decimal(10, 2)
  notes        String?
  tableId      Int
  table        Table       @relation(fields: [tableId], references: [id], onDelete: Restrict)
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tableId])
  @@index([restaurantId])
  @@index([status])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2) // snapshot price at time of order
  notes      String?
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// Customer calls waiter, asks for bill etc.
model ServiceRequest {
  id           Int           @id @default(autoincrement())
  requestType  RequestType
  status       RequestStatus @default(PENDING)
  note         String?
  tableId      Int
  table        Table         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  resolvedById Int?
  resolvedBy   Staff?        @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tableId])
  @@index([status])
  @@index([requestType])
}